{
  "name": "Terminus",
  "private": true,
  "version": "0.2.2",
  "license": "Apache-2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --target=node22 --packages=external --outfile=dist-electron/server.cjs",
    "desktop": "electron .",
    "desktop:dev": "electron .",
    "desktop:dir": "npm run build && npm run build:server && electron-builder --dir",
    "desktop:build": "npm run build && npm run build:server && electron-builder --publish never",
    "postdesktop:build": "npm run clean:release",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release server.js",
    "clean:release": "node scripts/clean-release.cjs",
    "lint": "npm run lint:types && npm run lint:eslint",
    "lint:types": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:adblock": "node scripts/e2e-adblock-electron.mjs",
    "test:e2e:installed": "node scripts/e2e-installed-ctrl-f.mjs",
    "test:e2e:python-sandbox": "tsx scripts/e2e-python-sandbox-chromium.ts"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sanitize-html": "^2.18.1",
    "tldts-experimental": "^7.4.21",
    "undici": "^8.12.4",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.terminus.browser",
    "productName": "Terminus",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Network"
    }
  },
  "overrides": {
    "@electron/universal": {
      "minimatch": "11.0.6"
    },
    "app-builder-lib": {
      "minimatch": "11.0.6"
    },
    "eslint": {
      "minimatch": "11.0.6"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.6"
    }
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
